# Gateway Server Settings
PORT=8000
HOST=0.0.0.0

# LLM Providers Configuration
# Toggle MOCK_CLOUD to true to simulate a cloud model without using internet/API keys
MOCK_CLOUD=true

# Real API Keys (Provide if MOCK_CLOUD=false)
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Local LLM (Ollama) Settings
LOCAL_LLM_URL=http://localhost:11434
LOCAL_LLM_MODEL=llama3.2:1b

# Database Configuration (Audit logs)
# Use mongodb://localhost:27017 for local Docker container database
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=securesphere

# Gateway Security & Routing Policies
# If true, the system will only mask PII and send it to the cloud rather than routing to Ollama
BYPASS_PII_ROUTING=false
ENFORCE_TOXICITY=true
TOXICITY_THRESHOLD=0.80
LOG_RAW_PII=false

# Numeric privacy for amounts: "ckks" = real CKKS homomorphic encryption (TenSEAL, default); "affine" = original affine masking (revert switch)
NUMERIC_PRIVACY_MODE=ckks

# Entity detection engine: "spacy" (default, regex + spaCy) or "spacy_bert" (adds an optional BERT NER layer; needs transformers + torch)
ENTITY_ENGINE=spacy
# Hugging Face token-classification model used when ENTITY_ENGINE=spacy_bert (loaded lazily on first use, CPU only)
BERT_NER_MODEL=dslim/bert-base-NER
# Minimum confidence for a BERT entity to be used (0-1)
BERT_MIN_SCORE=0.80
# BERT entity labels to use, comma separated (PER->PERSON, ORG->ORGANIZATION, LOC->LOCATION)
BERT_ENTITY_TYPES=PER,ORG,LOC
