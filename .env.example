# Gateway Server Settings
PORT=8000
HOST=0.0.0.0

# LLM Providers Configuration
# Toggle MOCK_CLOUD to true to simulate a cloud model without using internet/API keys
MOCK_CLOUD=true

# Real API Keys (Provide if MOCK_CLOUD=false)
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Local LLM (Ollama) Settings
LOCAL_LLM_URL=http://localhost:11434
LOCAL_LLM_MODEL=llama3.2:1b

# Database Configuration (Audit logs)
# Use mongodb://localhost:27017 for local Docker container database
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=securesphere

# Gateway Security & Routing Policies
# If true, the system will only mask PII and send it to the cloud rather than routing to Ollama
BYPASS_PII_ROUTING=false
ENFORCE_TOXICITY=true
TOXICITY_THRESHOLD=0.80
LOG_RAW_PII=false
